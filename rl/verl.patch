+    def _dp_chunked(self, fn, batch: DataProto, dp_size: int) -> DataProto:
+        """Apply `fn` to chunks of `batch`, each padded to a multiple of `dp_size`.
+
+        Agent loops that return one sample per step produce batches of arbitrary size.
+        """
+        outputs = []
+        for chunk in batch.split(self.config.trainer.get("dp_infer_chunk_size", 32)):
+            chunk, pad_size = pad_dataproto_to_divisor(chunk, dp_size)
+            outputs.append(unpad_dataproto(fn(chunk), pad_size=pad_size))
+        return DataProto.concat(outputs)
+
+    def _pad_for_update(self, batch: DataProto, dp_size: int) -> DataProto:
+        """Pad `batch` to a multiple of `dp_size` with copies of its last sample that carry no loss."""
+        pad_size = -len(batch) % dp_size
+        if pad_size == 0:
+            return batch
+        n = len(batch)
+        global_token_num = batch.meta_info.get("global_token_num")
+        batch = DataProto.concat([batch, batch.slice(n - 1, n).repeat(pad_size)])
+        for key in ("response_mask", "advantages", "returns", "values", "token_level_rewards", "token_level_scores"):
+            if key in batch.batch.keys():
+                batch.batch[key][n:] = 0
+        if global_token_num is not None:
+            batch.meta_info["global_token_num"] = list(global_token_num) + [0] * pad_size
+        return batch
+
     def _compute_values(self, batch: DataProto) -> DataProto:
